# Phase 5 Part 2: Approval Workflow

# Approval Tokens
APPROVAL_TOKEN_TTL_HOURS=48
APPROVAL_TOKEN_CLEANUP_ENABLED=true
APPROVAL_TOKEN_CLEANUP_INTERVAL_HOURS=1

# Encryption
ENCRYPTION_KEY=your-secret-encryption-key-here
ENCRYPT_PAYLOADS=true
ENCRYPTION_ALGORITHM=aes-256-gcm

# Email
APPROVAL_EMAIL_FROM=approvals@autoapply.app
APPROVAL_EMAIL_REPLY_TO=support@autoapply.app
APPROVAL_EMAIL_TEMPLATE=approval-email.html

# Field Matching
FIELD_MATCHING_CONFIDENCE_THRESHOLD=0.6
ENABLE_ANSWER_BANK_MATCHING=true
ENABLE_LLM_MATCHING=false

# Logging
ENABLE_APPROVAL_LOGGING=true
ENABLE_FIELD_MATCHING_LOGGING=true
LOG_APPROVAL_IP=true
LOG_APPROVAL_USER_AGENT=true

# Frontend
FRONTEND_URL=http://localhost:3000
APPROVAL_LINK_TTL=172800
