{
  "name": "autoapply",
  "version": "0.1.0",
  "description": "AutoApply - SaaS job application automation for India",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm -r --filter=./apps/api dev",
    "dev:all": "node scripts/dev-all.mjs",
    "dev:client": "npm --prefix frontend run dev",
    "dev:admin": "npm --prefix frontend/admin-console run dev",
    "build": "pnpm -r build && npm --prefix frontend run build && npm --prefix frontend/admin-console run build",
    "build:frontends": "npm --prefix frontend run build && npm --prefix frontend/admin-console run build",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:unit": "pnpm -r test --testPathPattern=spec.ts",
    "test:e2e": "pnpm -r test:e2e",
    "lint": "pnpm -r lint",
    "migrate": "pnpm -r --filter=./apps/api migrate",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "type-check": "pnpm -r type-check"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "concurrently": "^10.0.5",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
