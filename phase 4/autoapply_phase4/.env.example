# ============ PHASE 4 JOB DISCOVERY ============

# LLM & Embeddings
CLAUDE_API_KEY=sk-ant-...
EMBEDDING_MODEL=claude-3-5-sonnet-20241022
EMBEDDING_DIMENSION=1024

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/autoapply

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# ATS Source Adapters - Discovery
GREENHOUSE_BOARD_TOKENS=token1,token2,token3
GREENHOUSE_RPS=10
GREENHOUSE_PROXY_URL=http://proxy:8080

LEVER_COMPANY_IDS=company1,company2
LEVER_RPS=10
LEVER_PROXY_URL=

ASHBY_COMPANY_IDS=company1,company2
ASHBY_RPS=10
ASHBY_PROXY_URL=

# Job Aggregators (Phase 4)
JSEARCH_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Discovery Scheduling
DISCOVERY_SWEEP_INTERVAL_HOURS=4
MATCHING_BATCH_SIZE=50
MAX_CONCURRENT_PROCESSORS=5

# Matching
MIN_MATCH_SCORE_THRESHOLD=50
EMBEDDING_SIMILARITY_THRESHOLD=0.65
LLM_SCORING_ENABLED=true

# Data Retention
JOB_RETENTION_DAYS=180
CLOSED_JOB_DETECTION_ENABLED=true

# Environment
NODE_ENV=development
LOG_LEVEL=debug
