# ============ DATABASE ============
DATABASE_URL=postgresql://autoapply:password@localhost:5433/autoapply

# ============ REDIS & CACHE ============
REDIS_URL=redis://localhost:6379

# ============ S3 & STORAGE ============
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=autoapply
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=ap-south-1

# ============ JWT & TOKENS ============
# Generate with: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC1/8...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAtf/...\n-----END PUBLIC KEY-----"
JWT_EXPIRY=900
REFRESH_TOKEN_EXPIRY=2592000

# ============ OTP ============
OTP_LENGTH=6
OTP_TTL=300
OTP_MAX_ATTEMPTS=5
OTP_PEPPER=dev-pepper-change-in-production
OTP_RESEND_COOLDOWN=60
OTP_MAX_RESENDS_PER_HOUR=5

# ============ RATE LIMITING ============
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ============ KMS & ENCRYPTION ============
# For dev: use local mock (no real AWS credentials needed)
KMS_KEY_ID=arn:aws:kms:ap-south-1:123456789012:key/12345678-1234-1234-1234-123456789012
KMS_REGION=ap-south-1
KMS_ENDPOINT=http://localhost:8888
ENCRYPTION_ALGORITHM=aes-256-gcm

# ============ EMAIL (SES) ============
SES_REGION=ap-south-1
SES_ACCESS_KEY=dev-access-key
SES_SECRET_KEY=dev-secret-key
SES_FROM_EMAIL=noreply@autoapply.app

# ============ SMS (MSG91) ============
MSG91_AUTH_KEY=dev-auth-key
MSG91_ROUTE=1

# ============ APPLICATION ============
NODE_ENV=development
APP_NAME=AutoApply
APP_VERSION=0.1.0
API_PORT=3000
API_HOST=localhost
LOG_LEVEL=debug

# ============ CORS ============
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ============ RAZORPAY (Phase 3) ============
RAZORPAY_KEY_ID=dev-key-id
RAZORPAY_KEY_SECRET=dev-secret
RAZORPAY_WEBHOOK_SECRET=dev-webhook-secret

# ============ OBSERVABILITY ============
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ============ ADMIN ============
ADMIN_OTP_PEPPER=admin-pepper-dev

# ============ JOB DISCOVERY (Phase 4) ============
GREENHOUSE_BOARD_TOKENS=
LEVER_COMPANY_IDS=
ASHBY_COMPANY_IDS=
GREENHOUSE_HARVEST_API_KEY=
EMBEDDING_SIMILARITY_THRESHOLD=0.65
LLM_SCORING_ENABLED=true
